# The image only needs a small part of the repository, so everything is
# excluded by default and the required files are re-added below.
*

!packages/server/package.json
!packages/server/tsconfig.json
!packages/server/tsconfig-build.json
!packages/server/src
!packages/server/static
!packages/server/certs

# Never include local files, credentials or build output in the image
**/node_modules
**/dist
**/logs
**/.env
**/.env.*
**/*.sqlite
**/*.log
